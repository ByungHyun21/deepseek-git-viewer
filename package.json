{
  "name": "deepseek-github-viewer",
  "version": "0.1.0",
  "description": "관심 GitHub 사용자의 레포를 카드 갤러리로 보여주는 DeepSeek Harness 패널",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByungHyun21/deepseek-git-viewer.git"
  },
  "homepage": "https://github.com/ByungHyun21/deepseek-git-viewer#readme",
  "bugs": {
    "url": "https://github.com/ByungHyun21/deepseek-git-viewer/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "github",
    "repositories",
    "viewer"
  ],
  "main": "./plugin/host.js",
  "exports": {
    ".": "./plugin/host.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/host.js",
    "lib/github.js",
    "lib/client.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/*.png"
  ],
  "scripts": {
    "check": "node --check plugin/host.js && node --check lib/github.js && node --check lib/client.js",
    "test": "npm run check && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
